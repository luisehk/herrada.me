# The site is plain HTML, generated by build/build.py and committed, so there is
# no build stage: copy the site files into nginx and serve them (RK-0029,
# thepocketschool.mx's shape; HM-0002). Only the three pages, style.css,
# script.js, fonts/ and assets/ reach the web root. The build, the Dockerfile,
# the manifest, the make files and CNAME never ship.
FROM nginx:stable-alpine

LABEL org.opencontainers.image.source="https://github.com/luisehk/herrada.me"
LABEL org.opencontainers.image.description="herrada.me static site"

# The stock web root holds nginx's own index.html and 50x.html. Empty it, so the
# image serves this site's files and nothing else.
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY index.html how-i-build.html 404.html style.css script.js /usr/share/nginx/html/
COPY fonts/ /usr/share/nginx/html/fonts/
COPY assets/ /usr/share/nginx/html/assets/

# 127.0.0.1 rather than `localhost`: nginx listens on IPv4 only and Alpine's
# busybox wget resolves `localhost` to ::1 first.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
